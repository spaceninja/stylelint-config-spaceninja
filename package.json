{
  "name": "stylelint-config-spaceninja",
  "version": "17.0.0",
  "description": "Spaceninja's stylelint config",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "spaceninja"
  ],
  "repository": "spaceninja/stylelint-config-spaceninja",
  "license": "MIT",
  "author": "Scott Vandehey",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js"
  ],
  "scripts": {
    "lint": "run-s lint:js lint:prettier",
    "lint:check": "run-s lint:*:check",
    "lint:js": "eslint --fix .",
    "lint:js:check": "eslint .",
    "lint:prettier": "prettier --write .",
    "lint:prettier:check": "prettier --list-different .",
    "test": "node --test",
    "watch": "npm test --ignore-scripts -- --watch"
  },
  "prettier": "@stylelint/prettier-config",
  "dependencies": {
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-order": "8.1.2"
  },
  "devDependencies": {
    "@stylelint/prettier-config": "4.0.0",
    "eslint": "10.12.0",
    "eslint-config-stylelint": "28.0.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "stylelint": "17.16.0"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
